PORT=3000
# Ejecuta npm run configurar para generar .env con una contraseña aleatoria.
# Con PostgreSQL instalado o remoto, configura tu conexión privada en .env.
DATABASE_URL=postgresql://usuario:CONTRASENA@127.0.0.1:5432/ceicom
# Solo una conexión de desarrollo: las pruebas crean esquemas temporales.
TEST_DATABASE_URL=postgresql://usuario:CONTRASENA@127.0.0.1:5432/ceicom_test
SEED_DEMO=false
# Cambiar a true detrás de HTTPS en producción.
COOKIE_SECURE=false

# Opcional: carpeta bin de PostgreSQL si pg_dump no está en PATH.
# En Windows se busca automáticamente en Program Files/PostgreSQL.
# PG_BIN_DIR="C:/Program Files/PostgreSQL/17/bin"
# Solo para PostgreSQL del compose del proyecto: BACKUP_MODE=docker
