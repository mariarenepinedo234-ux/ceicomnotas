{
  "name": "ceicom-academico",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Registro académico y seguimiento de notas del Instituto Tecnológico Ceicom",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "configurar": "node scripts/configure.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:importar": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "crear-admin": "node --env-file-if-exists=.env scripts/admin.js",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.js",
    "db:restore": "node --env-file-if-exists=.env scripts/backup.js --restore",
    "catalogo:importar": "node --env-file-if-exists=.env scripts/catalog-excel.js",
    "grupos:importar": "node --env-file-if-exists=.env scripts/rosters.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
